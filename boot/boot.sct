; *************************************************************
; Bootloader 散转文件：只占前 32KB（0x08000000 ~ 0x08007FFF）
;
; 后面的 0x08008000 起是启动标志区，0x08010000 起是 APP 区，
; 都不归本工程管。故意把上限写死在 32KB，boot 一旦写胖了，
; 链接会直接报错溢出，而不是悄悄压到标志区上去。
; *************************************************************

LR_IROM1 0x08000000 0x00008000  {          ; 加载区：32KB
  ER_IROM1 0x08000000 0x00008000  {
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00020000  {
   .ANY (+RW +ZI)
  }
}
